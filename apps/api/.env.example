NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://postgres:1234@localhost:5432/sme_platform?schema=public
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_ISSUER=sme-platform-api
ACCESS_TOKEN_AUDIENCE=sme-platform-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_PEPPER=replace-with-a-different-32-character-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Optional idempotent platform-superadmin provisioning used by `pnpm prisma:seed`.
# Never commit real credentials. Password must contain at least 16 characters.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_DISPLAY_NAME=Platform Superadmin
