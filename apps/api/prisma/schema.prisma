enum PromotionType {
  DISCOUNT
  BUY_X_GET_Y
  BUNDLE_CROSS
  BILL_TOTAL
}

enum PromotionRewardType {
  DISCOUNT_PERCENT
  DISCOUNT_AMOUNT
  SPECIAL_PRICE
  FREE_ITEM
}

