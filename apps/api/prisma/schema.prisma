  startDate             DateTime            @map("start_date") @db.Timestamptz(6)
  endDate               DateTime            @map("end_date") @db.Timestamptz(6)
  startTime             String?             @map("start_time") @db.VarChar(10)
  endTime               String?             @map("end_time") @db.VarChar(10)
  daysOfWeek            String?             @map("days_of_week") @db.VarChar(30)
  branchScope           String?             @map("branch_scope") @db.VarChar(40)
  customerGroupScope    String?             @map("customer_group_scope") @db.VarChar(40)
  minQuantity           Decimal             @default(1) @map("min_quantity") @db.Decimal(20, 6)
  minAmount             Decimal             @default(0) @map("min_amount") @db.Decimal(20, 4)
  rewardType            PromotionRewardType @default(DISCOUNT_PERCENT) @map("reward_type")
  discountValue         Decimal             @default(0) @map("discount_value") @db.Decimal(20, 4)
  rewardQuantity        Decimal             @default(1) @map("reward_quantity") @db.Decimal(20, 6)
  rewardDiscountPercent Decimal             @default(100) @map("reward_discount_percent") @db.Decimal(5, 2)
  rewardProductId       String?             @map("reward_product_id") @db.Uuid
  rewardVariantId       String?             @map("reward_variant_id") @db.Uuid
  rewardUnitId          String?             @map("reward_unit_id") @db.Uuid
  maxDiscountCap        Decimal?            @map("max_discount_cap") @db.Decimal(20, 4)
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  business              Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items                 PromotionItem[]

  @@id([businessId, id], map: "pk_promotions_business_id")
  @@unique([businessId, code], map: "uq_promotions_code")
  @@index([businessId, active], map: "idx_promotions_active")
  @@index([businessId, startDate, endDate], map: "idx_promotions_date_range")
  @@map("promotions")
}

model PromotionItem {
  id          String    @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  productId   String?   @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  unitId      String?   @map("unit_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  promotion   Promotion @relation(fields: [businessId, promotionId], references: [businessId, id], onDelete: Cascade)

  @@id([businessId, id], map: "pk_promotion_items_business_id")
  @@index([businessId, promotionId], map: "idx_promotion_items_promo")
  @@index([businessId, productId], map: "idx_promotion_items_product")
  @@index([businessId, variantId], map: "idx_promotion_items_variant")
  @@index([businessId, unitId], map: "idx_promotion_items_unit")
  @@map("promotion_items")
}




