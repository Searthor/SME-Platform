enum PurchaseLifecycleStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Purchase {
  id              String                  @db.Uuid
  businessId      String                  @map("business_id") @db.Uuid
  branchId        String                  @map("branch_id") @db.Uuid
  warehouseId     String                  @map("warehouse_id") @db.Uuid
  supplierId      String                  @map("supplier_id") @db.Uuid
  purchaseNumber  String                  @map("purchase_number") @db.VarChar(50)
  lifecycleStatus PurchaseLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  paymentStatus   PurchasePaymentStatus   @default(UNPAID) @map("payment_status")
  currencyCode    String                  @map("currency_code") @db.Char(3)
  subtotal        Decimal                 @default(0) @db.Decimal(20, 4)
  taxAmount       Decimal                 @default(0) @map("tax_amount") @db.Decimal(20, 4)
  grandTotal      Decimal                 @default(0) @map("grand_total") @db.Decimal(20, 4)
  paidAmount      Decimal                 @default(0) @map("paid_amount") @db.Decimal(20, 4)
  notes           String?                 @db.VarChar(1000)
  orderedAt       DateTime?               @map("ordered_at") @db.Timestamptz(6)
  expectedAt      DateTime?               @map("expected_at") @db.Timestamptz(6)
  createdByUserId String                  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch                  @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  warehouse       Warehouse               @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  supplier        Supplier                @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: Restrict)
  items           PurchaseItem[]
  goodsReceipts   GoodsReceipt[]
  paymentAllocations PaymentAllocation[]

  @@id([businessId, id], map: "pk_purchases_business_id")
  @@unique([businessId, purchaseNumber], map: "uq_purchases_business_number")
  @@index([businessId, supplierId, createdAt(sort: Desc)], map: "idx_purchases_business_supplier")
  @@index([businessId, lifecycleStatus, paymentStatus], map: "idx_purchases_business_statuses")
  @@map("purchases")
}

model PurchaseItem {
  id               String               @db.Uuid
  businessId       String               @map("business_id") @db.Uuid
  purchaseId       String               @map("purchase_id") @db.Uuid
  variantId        String               @map("variant_id") @db.Uuid
  orderedQuantity  Decimal              @map("ordered_quantity") @db.Decimal(20, 6)
  receivedQuantity Decimal              @default(0) @map("received_quantity") @db.Decimal(20, 6)
  unitCost         Decimal              @map("unit_cost") @db.Decimal(20, 4)
  subtotal         Decimal              @db.Decimal(20, 4)
  taxAmount        Decimal              @default(0) @map("tax_amount") @db.Decimal(20, 4)
  totalAmount      Decimal              @map("total_amount") @db.Decimal(20, 4)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchase         Purchase             @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Cascade)
  variant          ProductVariant       @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict)
  receiptItems     GoodsReceiptItem[]

  @@id([businessId, id], map: "pk_purchase_items_business_id")
  @@index([businessId, purchaseId], map: "idx_purchase_items_purchase")
  @@map("purchase_items")
}

model GoodsReceipt {
  id               String             @db.Uuid
  businessId       String             @map("business_id") @db.Uuid
  purchaseId       String             @map("purchase_id") @db.Uuid
  warehouseId      String             @map("warehouse_id") @db.Uuid
  receiptNumber    String             @map("receipt_number") @db.VarChar(50)
  notes            String?            @db.VarChar(1000)
  receivedAt       DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  receivedByUserId String             @map("received_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  business         Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchase         Purchase           @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Restrict)
  warehouse        Warehouse          @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  items            GoodsReceiptItem[]

  @@id([businessId, id], map: "pk_goods_receipts_business_id")
  @@unique([businessId, receiptNumber], map: "uq_goods_receipts_business_number")
  @@index([businessId, purchaseId], map: "idx_goods_receipts_purchase")
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String         @db.Uuid
  businessId       String         @map("business_id") @db.Uuid
  goodsReceiptId   String         @map("goods_receipt_id") @db.Uuid
  purchaseItemId   String         @map("purchase_item_id") @db.Uuid
  variantId        String         @map("variant_id") @db.Uuid
  receivedQuantity Decimal        @map("received_quantity") @db.Decimal(20, 6)
  unitCost         Decimal        @map("unit_cost") @db.Decimal(20, 4)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  goodsReceipt     GoodsReceipt   @relation(fields: [businessId, goodsReceiptId], references: [businessId, id], onDelete: Cascade)
  purchaseItem     PurchaseItem   @relation(fields: [businessId, purchaseItemId], references: [businessId, id], onDelete: Restrict)
  variant          ProductVariant @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, id], map: "pk_goods_receipt_items_business_id")
  @@index([businessId, goodsReceiptId], map: "idx_goods_receipt_items_receipt")
  @@map("goods_receipt_items")
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum PaymentAllocationTargetType {
  PURCHASE
  SALE
}

model Payment {
  id              String            @db.Uuid
  businessId      String            @map("business_id") @db.Uuid
  branchId        String            @map("branch_id") @db.Uuid
  direction       PaymentDirection  @default(OUTBOUND)
  method          PaymentMethod     @default(CASH)
  amount          Decimal           @db.Decimal(20, 4)
  currencyCode    String            @map("currency_code") @db.Char(3)
  paidAt          DateTime          @default(now()) @map("paid_at") @db.Timestamptz(6)
  reference       String?           @db.VarChar(120)
  notes           String?           @db.VarChar(500)
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch            @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  allocations     PaymentAllocation[]

  @@id([businessId, id], map: "pk_payments_business_id")
  @@index([businessId, branchId, paidAt(sort: Desc)], map: "idx_payments_business_branch_paid")
  @@map("payments")
}

model PaymentAllocation {
  id         String                      @db.Uuid
  businessId String                      @map("business_id") @db.Uuid
  paymentId  String                      @map("payment_id") @db.Uuid
  targetType PaymentAllocationTargetType @map("target_type")
  targetId   String                      @map("target_id") @db.Uuid
  amount     Decimal                     @db.Decimal(20, 4)
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  payment    Payment                     @relation(fields: [businessId, paymentId], references: [businessId, id], onDelete: Cascade)
  purchase   Purchase?                   @relation(fields: [businessId, targetId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, id], map: "pk_payment_allocations_business_id")
  @@index([businessId, paymentId], map: "idx_payment_allocations_payment")
  @@index([businessId, targetType, targetId], map: "idx_payment_allocations_target")
  @@map("payment_allocations")
}

