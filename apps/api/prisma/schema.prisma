  status           PosSessionStatus  @default(OPEN)
  
  openedAt         DateTime          @default(now()) @map("opened_at") @db.Timestamptz(6)
  openedByUserId   String            @map("opened_by_user_id") @db.Uuid
  openingCash      Decimal           @default(0) @map("opening_cash") @db.Decimal(20, 4)

  closedAt         DateTime?         @map("closed_at") @db.Timestamptz(6)
  closedByUserId   String?           @map("closed_by_user_id") @db.Uuid
  closingCashCount Decimal?          @map("closing_cash_count") @db.Decimal(20, 4)
  expectedCash     Decimal?          @map("expected_cash") @db.Decimal(20, 4)
  cashDifference   Decimal?          @map("cash_difference") @db.Decimal(20, 4)
  notes            String?           @db.VarChar(1000)

  totalSalesCount  Int               @default(0) @map("total_sales_count")
  totalGrossSales  Decimal           @default(0) @map("total_gross_sales") @db.Decimal(20, 4)
  totalDiscount    Decimal           @default(0) @map("total_discount") @db.Decimal(20, 4)
  totalNetSales    Decimal           @default(0) @map("total_net_sales") @db.Decimal(20, 4)
  totalCashSales   Decimal           @default(0) @map("total_cash_sales") @db.Decimal(20, 4)
  totalBankSales   Decimal           @default(0) @map("total_bank_sales") @db.Decimal(20, 4)
  totalCreditSales Decimal           @default(0) @map("total_credit_sales") @db.Decimal(20, 4)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  register         PosRegister       @relation(fields: [businessId, registerId], references: [businessId, id], onDelete: Restrict)
  sales            Sale[]
  cashMovements    PosCashMovement[]

  @@id([businessId, id], map: "pk_pos_sessions_business_id")
  @@unique([businessId, sessionNumber], map: "uq_pos_sessions_number")
  @@index([businessId, branchId, status], map: "idx_pos_sessions_branch_status")
  @@map("pos_sessions")
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

model PosCashMovement {
