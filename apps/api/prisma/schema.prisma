generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum IdentityType {
  EMAIL
  PHONE
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum BusinessInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id                  String               @id @db.Uuid
  displayName         String               @map("display_name") @db.VarChar(120)
  locale              String               @default("lo") @db.VarChar(10)
  status              UserStatus           @default(ACTIVE)
  platformRole        PlatformRole         @default(USER) @map("platform_role")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities          UserIdentity[]
  credential          PasswordCredential?
  sessions            AuthSession[]
  memberships         BusinessMember[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  invitationsCreated  BusinessInvitation[] @relation("InvitationCreator")
  invitationsAccepted BusinessInvitation[] @relation("InvitationAcceptor")

  @@map("users")
}

model PlatformSettings {
  id                  String   @id @default("default") @db.VarChar(32)
  platformName        String   @default("SME Flow") @map("platform_name") @db.VarChar(120)
  supportEmail        String?  @map("support_email") @db.VarChar(254)
  defaultLocale       String   @default("lo") @map("default_locale") @db.VarChar(10)
  defaultCurrencyCode String   @default("LAK") @map("default_currency_code") @db.Char(3)
  defaultTimezone     String   @default("Asia/Vientiane") @map("default_timezone") @db.VarChar(80)
  allowRegistration   Boolean  @default(true) @map("allow_registration")
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

model UserIdentity {
  id              String       @id @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  type            IdentityType
  normalizedValue String       @map("normalized_value") @db.VarChar(254)
  verifiedAt      DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, normalizedValue], map: "uq_user_identities_type_value")
  @@index([userId], map: "idx_user_identities_user")
  @@map("user_identities")
}

model PasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AuthSession {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenFamilyId      String    @map("token_family_id") @db.Uuid
  refreshTokenHash   String    @unique(map: "uq_auth_sessions_refresh_hash") @map("refresh_token_hash") @db.Char(64)
  selectedBusinessId String?   @map("selected_business_id") @db.Uuid
  selectedMemberId   String?   @map("selected_member_id") @db.Uuid
  deviceName         String?   @map("device_name") @db.VarChar(120)
  ipAddress          String?   @map("ip_address") @db.VarChar(64)
  userAgent          String?   @map("user_agent") @db.VarChar(512)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(6)
  rotatedAt          DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById       String?   @unique(map: "uq_auth_sessions_replaced_by") @map("replaced_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "idx_auth_sessions_user_revoked")
  @@index([tokenFamilyId], map: "idx_auth_sessions_family")
  @@index([expiresAt], map: "idx_auth_sessions_expires")
  @@map("auth_sessions")
}

model Business {
  id           String               @id @db.Uuid
  name         String               @db.VarChar(160)
  currencyCode String               @map("currency_code") @db.Char(3)
  timezone     String               @db.VarChar(80)
  status       BusinessStatus       @default(ACTIVE)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches     Branch[]
  members      BusinessMember[]
  roles        Role[]
  invitations  BusinessInvitation[]
  auditLogs    AuditLog[]
  categories   Category[]
  units        Unit[]
  products     Product[]
  variants     ProductVariant[]
  barcodes     ProductBarcode[]
  productUnits ProductUnit[]
  warehouses   Warehouse[]
  suppliers    Supplier[]
  purchases    Purchase[]
  goodsReceipts GoodsReceipt[]
  payments     Payment[]
  posRegisters PosRegister[]
  posSessions  PosSession[]
  sales        Sale[]
  customerGroups CustomerGroup[]
  customers      Customer[]
  variantGroupPrices ProductVariantGroupPrice[]
  promotions     Promotion[]
  promotionItems PromotionItem[]

  @@map("businesses")
}

model Branch {
  id               String                           @db.Uuid
  businessId       String                           @map("business_id") @db.Uuid
  code             String                           @db.VarChar(40)
  name             String                           @db.VarChar(160)
  status           BranchStatus                     @default(ACTIVE)
  createdAt        DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  business         Business                         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  grants           MemberBranchAccess[]
  invitationGrants BusinessInvitationBranchAccess[]
  warehouses       Warehouse[]
  purchases        Purchase[]
  payments         Payment[]
  posRegisters     PosRegister[]
  posSessions      PosSession[]
  sales            Sale[]

  @@id([businessId, id], map: "pk_branches_business_id")
  @@unique([businessId, code], map: "uq_branches_business_code")
  @@index([businessId, status], map: "idx_branches_business_status")
  @@map("branches")
}

model BusinessMember {
  id                   String               @db.Uuid
  businessId           String               @map("business_id") @db.Uuid
  userId               String               @map("user_id") @db.Uuid
  status               MemberStatus         @default(ACTIVE)
  allBranches          Boolean              @default(false) @map("all_branches")
  authorizationVersion Int                  @default(1) @map("authorization_version")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchAccess         MemberBranchAccess[]
  roles                MemberRole[]

  @@id([businessId, id], map: "pk_business_members_business_id")
  @@unique([businessId, userId], map: "uq_business_members_business_user")
  @@index([userId, status], map: "idx_business_members_user_status")
  @@map("business_members")
}

model Role {
  id          String                   @db.Uuid
  businessId  String                   @map("business_id") @db.Uuid
  code        String                   @db.VarChar(60)
  name        String                   @db.VarChar(120)
  isSystem    Boolean                  @default(false) @map("is_system")
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  business    Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  members     MemberRole[]
  invitations BusinessInvitationRole[]

  @@id([businessId, id], map: "pk_roles_business_id")
  @@unique([businessId, code], map: "uq_roles_business_code")
  @@index([businessId, name], map: "idx_roles_business_name")
  @@map("roles")
}

model Permission {
  code        String           @id @db.VarChar(100)
  description String           @db.VarChar(200)
  module      String           @db.VarChar(60)
  roles       RolePermission[]

  @@index([module, code], map: "idx_permissions_module_code")
  @@map("permissions")
}

model RolePermission {
  businessId     String     @map("business_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(100)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role           Role       @relation(fields: [businessId, roleId], references: [businessId, id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([businessId, roleId, permissionCode], map: "pk_role_permissions")
  @@index([permissionCode], map: "idx_role_permissions_permission")
  @@map("role_permissions")
}

model MemberRole {
  businessId String         @map("business_id") @db.Uuid
  memberId   String         @map("member_id") @db.Uuid
  roleId     String         @map("role_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  member     BusinessMember @relation(fields: [businessId, memberId], references: [businessId, id], onDelete: Cascade)
  role       Role           @relation(fields: [businessId, roleId], references: [businessId, id], onDelete: Cascade)

  @@id([businessId, memberId, roleId], map: "pk_member_roles")
  @@index([businessId, roleId], map: "idx_member_roles_role")
  @@map("member_roles")
}

model MemberBranchAccess {
  id         String         @id @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  memberId   String         @map("member_id") @db.Uuid
  branchId   String         @map("branch_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  member     BusinessMember @relation(fields: [businessId, memberId], references: [businessId, id], onDelete: Cascade)
  branch     Branch         @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, memberId, branchId], map: "uq_member_branch_access")
  @@index([businessId, branchId], map: "idx_member_branch_access_branch")
  @@map("member_branch_access")
}

model BusinessInvitation {
  id                 String                           @db.Uuid
  businessId         String                           @map("business_id") @db.Uuid
  identityType       IdentityType                     @map("identity_type")
  normalizedIdentity String                           @map("normalized_identity") @db.VarChar(254)
  tokenHash          String                           @unique(map: "uq_business_invitations_token_hash") @map("token_hash") @db.Char(64)
  status             BusinessInvitationStatus         @default(PENDING)
  allBranches        Boolean                          @default(false) @map("all_branches")
  expiresAt          DateTime                         @map("expires_at") @db.Timestamptz(6)
  acceptedAt         DateTime?                        @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId     String?                          @map("accepted_user_id") @db.Uuid
  createdByUserId    String                           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  business           Business                         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy          User                             @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy         User?                            @relation("InvitationAcceptor", fields: [acceptedUserId], references: [id], onDelete: Restrict)
  roles              BusinessInvitationRole[]
  branchAccess       BusinessInvitationBranchAccess[]

  @@id([businessId, id], map: "pk_business_invitations_business_id")
  @@index([businessId, status, createdAt(sort: Desc)], map: "idx_business_invitations_status")
  @@index([identityType, normalizedIdentity], map: "idx_business_invitations_identity")
  @@map("business_invitations")
}

model BusinessInvitationRole {
  businessId   String             @map("business_id") @db.Uuid
  invitationId String             @map("invitation_id") @db.Uuid
  roleId       String             @map("role_id") @db.Uuid
  invitation   BusinessInvitation @relation(fields: [businessId, invitationId], references: [businessId, id], onDelete: Cascade)
  role         Role               @relation(fields: [businessId, roleId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, invitationId, roleId], map: "pk_business_invitation_roles")
  @@index([businessId, roleId], map: "idx_business_invitation_roles_role")
  @@map("business_invitation_roles")
}

model BusinessInvitationBranchAccess {
  businessId   String             @map("business_id") @db.Uuid
  invitationId String             @map("invitation_id") @db.Uuid
  branchId     String             @map("branch_id") @db.Uuid
  invitation   BusinessInvitation @relation(fields: [businessId, invitationId], references: [businessId, id], onDelete: Cascade)
  branch       Branch             @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, invitationId, branchId], map: "pk_business_invitation_branches")
  @@index([businessId, branchId], map: "idx_business_invitation_branches_branch")
  @@map("business_invitation_branch_access")
}

model AuditLog {
  id         String    @id @db.Uuid
  businessId String?   @map("business_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  action     String    @db.VarChar(100)
  entityType String    @map("entity_type") @db.VarChar(80)
  entityId   String?   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  requestId  String?   @map("request_id") @db.VarChar(80)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       User?     @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc), id], map: "idx_audit_logs_business_created")
  @@index([businessId, entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

model Category {
  id         String     @db.Uuid
  businessId String     @map("business_id") @db.Uuid
  parentId   String?    @map("parent_id") @db.Uuid
  name       String     @db.VarChar(120)
  archivedAt DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parent     Category?  @relation("CategoryTree", fields: [businessId, parentId], references: [businessId, id], onDelete: Restrict)
  children   Category[] @relation("CategoryTree")
  products   Product[]

  @@id([businessId, id], map: "pk_categories_business_id")
  @@unique([businessId, name], map: "uq_categories_business_name")
  @@index([businessId, archivedAt, name], map: "idx_categories_business_archived_name")
  @@map("categories")
}

model Unit {
  id            String    @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  code          String    @db.VarChar(30)
  name          String    @db.VarChar(80)
  decimalPlaces Int       @default(0) @map("decimal_places")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products      Product[]
  productUnits  ProductUnit[]

  @@id([businessId, id], map: "pk_units_business_id")
  @@unique([businessId, code], map: "uq_units_business_code")
  @@index([businessId, active, name], map: "idx_units_business_active_name")
  @@map("units")
}

model Product {
  id             String           @db.Uuid
  businessId     String           @map("business_id") @db.Uuid
  categoryId     String?          @map("category_id") @db.Uuid
  unitId         String           @map("unit_id") @db.Uuid
  name           String           @db.VarChar(180)
  description    String?          @db.VarChar(1000)
  trackStock     Boolean          @default(true) @map("track_stock")
  taxCode        String?          @map("tax_code") @db.VarChar(40)
  active         Boolean          @default(true)
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(6)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category       Category?        @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  unit           Unit             @relation(fields: [businessId, unitId], references: [businessId, id], onDelete: Restrict)
  variants       ProductVariant[]
  packagingUnits ProductUnit[]

  @@id([businessId, id], map: "pk_products_business_id")
  @@index([businessId, archivedAt, active, name], map: "idx_products_business_state_name")
  @@index([businessId, categoryId], map: "idx_products_business_category")
  @@map("products")
}

model ProductVariant {
  id           String           @db.Uuid
  businessId   String           @map("business_id") @db.Uuid
  productId    String           @map("product_id") @db.Uuid
  name         String?          @db.VarChar(120)
  size         String?          @db.VarChar(60)
  color        String?          @db.VarChar(60)
  sku          String?          @db.VarChar(80)
  cost         Decimal          @default(0) @db.Decimal(20, 4)
  sellingPrice Decimal          @map("selling_price") @db.Decimal(20, 4)
  minStock     Decimal          @default(0) @map("min_stock") @db.Decimal(20, 6)
  isDefault    Boolean          @default(false) @map("is_default")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product      Product          @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  barcodes     ProductBarcode[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  purchaseItems     PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]
  saleItems         SaleItem[]
  groupPrices       ProductVariantGroupPrice[]

  @@id([businessId, id], map: "pk_product_variants_business_id")
  @@unique([businessId, sku], map: "uq_product_variants_business_sku")
  @@index([businessId, productId, active], map: "idx_product_variants_business_product")
  @@map("product_variants")
}

model ProductBarcode {
  id         String         @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  barcode    String         @db.VarChar(100)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  variant    ProductVariant @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: Cascade)

  @@id([businessId, id], map: "pk_product_barcodes_business_id")
  @@unique([businessId, barcode], map: "uq_product_barcodes_business_barcode")
  @@index([businessId, variantId], map: "idx_product_barcodes_business_variant")
  @@map("product_barcodes")
}

model ProductUnit {
  id             String   @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  conversionRate Decimal  @map("conversion_rate") @db.Decimal(20, 6)
  sellingPrice   Decimal? @map("selling_price") @db.Decimal(20, 4)
  barcode        String?  @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  unit     Unit     @relation(fields: [businessId, unitId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, id], map: "pk_product_units_business_id")
  @@unique([businessId, productId, unitId], map: "uq_product_units_business_product_unit")
  @@index([businessId, productId], map: "idx_product_units_business_product")
  @@map("product_units")
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model Warehouse {
  id         String          @db.Uuid
  businessId String          @map("business_id") @db.Uuid
  branchId   String          @map("branch_id") @db.Uuid
  code       String          @db.VarChar(40)
  name       String          @db.VarChar(160)
  isDefault  Boolean         @default(false) @map("is_default")
  status     WarehouseStatus @default(ACTIVE)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch          @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  purchases     Purchase[]
  goodsReceipts GoodsReceipt[]
  sales         Sale[]

  @@id([businessId, id], map: "pk_warehouses_business_id")
  @@unique([businessId, code], map: "uq_warehouses_business_code")
  @@index([businessId, branchId, status], map: "idx_warehouses_business_branch_status")
  @@map("warehouses")
}

model StockBalance {
  id          String   @id @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(20, 6)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse   Warehouse      @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict)

  @@unique([warehouseId, variantId], map: "uq_stock_balances_warehouse_variant")
  @@index([businessId, warehouseId], map: "idx_stock_balances_business_warehouse")
  @@index([businessId, variantId], map: "idx_stock_balances_business_variant")
  @@map("stock_balances")
}

enum StockMovementType {
  PURCHASE_RECEIPT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  SALE
}

model StockMovement {
  id             String            @id @db.Uuid
  businessId     String            @map("business_id") @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  variantId      String            @map("variant_id") @db.Uuid
  type           StockMovementType
  quantityDelta  Decimal           @map("quantity_delta") @db.Decimal(20, 6)
  referenceType  String?           @map("reference_type") @db.VarChar(50)
  referenceId    String?           @map("reference_id") @db.Uuid
  reversalOfId   String?           @map("reversal_of_id") @db.Uuid
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  notes          String?           @db.VarChar(500)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  warehouse      Warehouse         @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  variant        ProductVariant    @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, warehouseId, variantId, createdAt(sort: Desc)], map: "idx_stock_movements_history")
