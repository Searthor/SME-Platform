enum PosSessionStatus {
  OPEN
  CLOSED
}

model PosSession {
  id               String            @db.Uuid
  businessId       String            @map("business_id") @db.Uuid
  branchId         String            @map("branch_id") @db.Uuid
  registerId       String            @map("register_id") @db.Uuid
