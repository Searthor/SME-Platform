  amount      Decimal          @db.Decimal(20, 4)
  reason      String           @db.VarChar(255)
  performedBy String           @map("performed_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  session     PosSession       @relation(fields: [businessId, sessionId], references: [businessId, id], onDelete: Cascade)

  @@id([businessId, id], map: "pk_pos_cash_movements_business_id")
  @@index([businessId, sessionId], map: "idx_pos_cash_movements_session")
  @@map("pos_cash_movements")
}

enum SaleLifecycleStatus {
  COMPLETED
  CANCELLED
}

enum SalePaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

model Sale {
  id              String              @db.Uuid
  businessId      String              @map("business_id") @db.Uuid
  branchId        String              @map("branch_id") @db.Uuid
  warehouseId     String              @map("warehouse_id") @db.Uuid
  posSessionId    String?             @map("pos_session_id") @db.Uuid
  saleNumber      String              @map("sale_number") @db.VarChar(50)
  customerId      String?             @map("customer_id") @db.Uuid
  customerName    String?             @map("customer_name") @db.VarChar(160)
  
  currencyCode    String              @default("LAK") @map("currency_code") @db.Char(3)
  subtotal        Decimal             @db.Decimal(20, 4)
  discountAmount  Decimal             @default(0) @map("discount_amount") @db.Decimal(20, 4)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(20, 4)
  grandTotal      Decimal             @db.Decimal(20, 4)
  paidAmount      Decimal             @default(0) @map("paid_amount") @db.Decimal(20, 4)
  changeAmount    Decimal             @default(0) @map("change_amount") @db.Decimal(20, 4)

  lifecycleStatus SaleLifecycleStatus @default(COMPLETED) @map("lifecycle_status")
  paymentStatus   SalePaymentStatus   @default(PAID) @map("payment_status")
  
  soldAt          DateTime            @default(now()) @map("sold_at") @db.Timestamptz(6)
  cashierUserId   String              @map("cashier_user_id") @db.Uuid
  promotionId     String?             @map("promotion_id") @db.Uuid
  notes           String?             @db.VarChar(500)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch              @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  warehouse       Warehouse           @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  session         PosSession?         @relation(fields: [businessId, posSessionId], references: [businessId, id], onDelete: SetNull)
  customer        Customer?           @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: SetNull)
  items           SaleItem[]
  payments        SalePayment[]

  @@id([businessId, id], map: "pk_sales_business_id")
  @@unique([businessId, saleNumber], map: "uq_sales_number")
  @@index([businessId, posSessionId], map: "idx_sales_session")
  @@index([businessId, soldAt(sort: Desc)], map: "idx_sales_business_date")
  @@map("sales")
}

model SaleItem {
