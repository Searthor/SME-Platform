  productName     String         @map("product_name") @db.VarChar(200)
  variantName     String?        @map("variant_name") @db.VarChar(100)
  unitName        String?        @map("unit_name") @db.VarChar(80)
  quantity        Decimal        @db.Decimal(20, 6)
  unitCost        Decimal        @map("unit_cost") @db.Decimal(20, 4)
  unitPrice       Decimal        @map("unit_price") @db.Decimal(20, 4)
