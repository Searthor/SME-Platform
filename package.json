{
  "name": "sme-platform",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @sme/api --filter @sme/web dev",
    "dev:api": "pnpm --filter @sme/api dev",
    "dev:web": "pnpm --filter @sme/web dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @sme/api test:integration",
    "test:e2e": "pnpm --filter @sme/api test:e2e",
    "prisma:generate": "pnpm --filter @sme/api prisma:generate",
    "prisma:migrate": "pnpm --filter @sme/api prisma:migrate",
    "prisma:seed": "pnpm --filter @sme/api prisma:seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  }
}
